# AI Agent 配置示例（DeepSeek）
# 复制此文件为 .env 并填入实际值，保存后重启服务生效

# DeepSeek API Key（必填，在 https://platform.deepseek.com 申请）
GZD_AGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# 模型名称（deepseek-chat=通用对话模型，支持工具调用；deepseek-reasoner=深度思考模型）
GZD_AGENT_MODEL=deepseek-chat

# DeepSeek 接口地址（OpenAI 兼容格式，一般无需修改）
GZD_AGENT_BASE_URL=https://api.deepseek.com
